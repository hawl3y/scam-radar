# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# Use the DEV project locally. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses RLS; used to insert reports after redaction. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Server-only. Any long random string (e.g. `openssl rand -hex 32`); hashes IPs for rate limits.
# Use a different value in each environment.
RATE_LIMIT_SALT=change-me

# Alerts (Phase 3). All server-only except NEXT_PUBLIC_SITE_URL.
# Base URL for links in emails, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Resend API key with sending access for scam-radar.joechawley.com.
RESEND_API_KEY=re_xxx
# Random strings (openssl rand -hex 32). CRON_SECRET protects /api/cron/digest;
# EMAIL_TOKEN_SECRET signs the no-sign-in email preference links.
CRON_SECRET=change-me
EMAIL_TOKEN_SECRET=change-me
# Optional: reports + "got this too" that trigger instant emails (default 3).
# ALERT_INSTANT_THRESHOLD=3

# Trending (Phase 5). Free key from https://api.data.gov/signup (server-only).
FTC_API_KEY=xxx
